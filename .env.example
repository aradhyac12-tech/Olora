# Copy to .env (never commit). Test DB matches docker-compose.test.yml
DATABASE_URL=postgres://wcim_test:wcim_test_password@localhost:55432/wcim_test
API_PORT=3000
API_HOST=127.0.0.1
LOG_LEVEL=info
# Comma-separated exact origins allowed to call the API from the app (Capacitor Android default: https://localhost)
CORS_ORIGINS=https://localhost
# Google sign-in via Supabase (own olora project). Both values are PUBLIC client values (publishable key), never the service_role key.
SUPABASE_URL=https://reazimolvvcatpirqqsk.supabase.co
SUPABASE_ANON_KEY=sb_publishable_gKW4JAYDrlUc-h7_nh4WOA_Xuuphptw
# Set true ONLY behind a trusted reverse proxy (Render etc.) so per-IP rate limits see the real client.
TRUST_PROXY=false
# auto (follow the URL) | disable | no-verify (TLS, cert not verified; use for the Supabase pooler) | verify (full check; add Supabase's CA via NODE_EXTRA_CA_CERTS)
DATABASE_SSL=auto
